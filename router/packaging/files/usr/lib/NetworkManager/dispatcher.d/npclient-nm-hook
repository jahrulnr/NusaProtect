#!/bin/sh

# Resume the VPN connection if the network comes back up

set -e

PIDFILE=/tmp/npservice_disconnected.pid

resume_vpn() {
  if [ -f $PIDFILE ]; then
    PID=$(cat $PIDFILE)

    # Always remove the PID file
    rm $PIDFILE

    # Ensure the PID is a npservice process (installed name)
    if ps -p $PID -o comm= | grep -qE 'npservice|gpservice'; then
      # Send a USR2 signal to resume the VPN connection
      kill -USR2 $PID
    fi
  fi
}

if [ "$2" = "up" ]; then
  resume_vpn
fi
